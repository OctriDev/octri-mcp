{
  "name": "@octri/mcp",
  "version": "1.0.0",
  "description": "MCP server for Octri API documentation — use your API docs as context in Claude, Cursor, and more",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "octri-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm build && node --test dist/index.test.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist .turbo",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "api-docs",
    "octri",
    "claude",
    "cursor",
    "ai"
  ],
  "author": "Octri",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
