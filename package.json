{
  "name": "@octri/mcp",
  "version": "1.4.0",
  "mcpName": "dev.octri/mcp",
  "description": "MCP server for an Octri project: search its API docs and call its endpoints from Claude, Cursor, and other clients",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "api-docs",
    "octri",
    "claude",
    "cursor",
    "ai"
  ],
  "homepage": "https://octri.dev",
  "bugs": {
    "url": "https://octri.dev/support"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octridev/octri-mcp.git"
  },
  "license": "MIT",
  "author": "Octri",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "octri-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**",
    "!dist/**/*.test.*",
    "vendor/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "test": "pnpm build && node --test dist/*.test.js && node --disallow-code-generation-from-strings --test dist/worker.test.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist bundle .mcpb-build .turbo",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "quickjs-emscripten-core": "0.32.0",
    "sucrase": "3.35.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@cfworker/json-schema": "4.1.1",
    "@types/node": "^20.0.0",
    "esbuild": "0.27.4",
    "typescript": "^5.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
